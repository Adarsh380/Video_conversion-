{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 1
          },
          "visualKeywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "textPlacement": {
            "type": "object",
            "properties": {
              "x": {
                "type": "string"
              },
              "y": {
                "type": "string"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "audioVolume": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "voice": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "duration"
        ],
        "additionalProperties": true
      }
    },
    "backgroundMusic": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "sessions"
  ],
  "additionalProperties": true,
  "": "http://json-schema.org/draft-07/schema#"
}